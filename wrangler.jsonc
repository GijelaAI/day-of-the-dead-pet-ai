{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-site",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server-entry.ts",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://example.com",
    "SITE_NAME": "Example Site"
  }
}